{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/share/**",
        "function": "shareOg"
      },
      {
        "source": "/p/**",
        "function": "presentationOg"
      },
      {
        "source": "/api/welcome-email",
        "function": "welcomeEmail"
      },
      {
        "source": "/api/blog/publish",
        "function": "blogAgentPublish"
      },
      {
        "source": "/api/blog/jobs/**",
        "function": "blogAgentStatus"
      },
      {
        "source": "/api/blog/posts/**",
        "function": "blogAgentDelete"
      },
      {
        "source": "/api/hwpx/fill",
        "function": "hwpxFill"
      },
      {
        "source": "/api/hwpx/inspect",
        "function": "hwpxInspect"
      },
      {
        "source": "/api/hwpx/apply",
        "function": "hwpxApply"
      },
      {
        "source": "/api/hwpx/expand-rows",
        "function": "hwpxExpandRows"
      },
      {
        "source": "/api/paddle-webhook",
        "function": "paddleWebhook"
      },
      {
        "source": "/api/guide",
        "function": "agentGuide"
      },
      {
        "source": "/api/tools",
        "function": "agentTools"
      },
      {
        "source": "/api/design-systems",
        "function": "designSystems"
      },
      {
        "source": "/api/design-systems/**",
        "function": "designSystems"
      },
      {
        "source": "/api/pages",
        "function": "publishPage"
      },
      {
        "source": "/api/pages/**",
        "function": "publishPage"
      },
      {
        "source": "/api/presentations",
        "function": "publishPresentation"
      },
      {
        "source": "/api/presentations/**",
        "function": "publishPresentation"
      },
      {
        "source": "/ai",
        "function": "aiSetupPage"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
